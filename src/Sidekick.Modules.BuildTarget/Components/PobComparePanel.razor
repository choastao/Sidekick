@implements IDisposable
@using System.Globalization
@using Sidekick.Game.Parser.Items

@* PoB2 引擎试穿对比：只在「开关打开 + 有目标BD + 这件物品算得了」时给数字。 *@
@if (Options.PobEngine && Item != null)
{
    <div class="mt-4">
        <FormFieldset Legend="@Resources["Pob_Title"]">

            @* 当前评估场景：引擎在**载入那一刻**按这个场景重算（内存态覆盖，不动 BD 文件），
               所以切换后是「下次载入生效」。副标题里带一个名字，用户不用去设置页猜现在按哪个算的。 *@
            <TextBase Class="text-stone-500 text-xs">@ContextText()</TextBase>

            @if (loading)
            {
                <TextBase Class="text-stone-400 text-sm">@Resources["Pob_Working"]</TextBase>
            }
            else if (result is { HasDelta: true })
            {
                <table class="w-full text-sm border-collapse">
                    <thead>
                    <tr class="text-stone-500 text-xs text-left">
                        <th class="font-normal py-1"></th>
                        <th class="font-normal py-1 text-right">@Resources["Pob_Before"]</th>
                        <th class="font-normal py-1 text-right">@Resources["Pob_After"]</th>
                        <th class="font-normal py-1 text-right">@Resources["Pob_Delta"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr class="border-t border-stone-700">
                        <td class="py-1">@Resources["Pob_Dps"]</td>
                        @if (result.DpsUnavailable)
                        {
                            @* 引擎算不出伤害时显示「—」而不是 0：0 会被读成「这件装备没变化」，
                               而事实是「这个数压根算不出来」—— 两种结论完全相反。 *@
                            <td class="py-1 text-right text-stone-500">—</td>
                            <td class="py-1 text-right text-stone-500">—</td>
                            <td class="py-1 text-right text-stone-500">—</td>
                        }
                        else
                        {
                            <td class="py-1 text-right text-stone-400">@Num(result.Base!.Dps)</td>
                            <td class="py-1 text-right">@Num(result.Current!.Dps)</td>
                            <td class="py-1 text-right @DeltaClass(result.DpsDelta)">@Signed(result.DpsDelta)@Pct(result.DpsPercent)</td>
                        }
                    </tr>
                    <tr class="border-t border-stone-700">
                        <td class="py-1">@Resources["Pob_Ehp"]</td>
                        <td class="py-1 text-right text-stone-400">@Num(result.Base!.Ehp)</td>
                        <td class="py-1 text-right">@Num(result.Current!.Ehp)</td>
                        <td class="py-1 text-right @DeltaClass(result.EhpDelta)">@Signed(result.EhpDelta)@Pct(result.EhpPercent)</td>
                    </tr>
                    </tbody>
                </table>

                @* ③ 引擎指标判定（与下面「按你的门槛判」那条轴是两回事，各有各的意思）。
                   判定顺序与判据见 ItemVerdictDecider；理由用 ReasonKey 对应的文案原样带出来 ——
                   Unresolved（算不了）时也要把**为什么**写出来，不能只丢一个「算不了」。 *@
                <div class="mt-2">
                    <TextBase Class="@($"text-sm {EngineVerdictOf(result).Class}")">@EngineVerdictOf(result).Label</TextBase>
                    <TextBase Class="text-stone-500 text-xs">@EngineVerdictOf(result).Reason</TextBase>
                </div>

                @if (result.DpsUnavailable)
                {
                    <TextBase Class="text-amber-400 text-xs mt-2">@Resources["Pob_Dps_Unavailable"]</TextBase>
                }
                else if (PrimaryMetricText(result) is { } metricText)
                {
                    <TextBase Class="text-stone-500 text-xs mt-2">@metricText</TextBase>
                }

                @if (result.UnmappedAffixes > 0)
                {
                    <TextBase Class="text-amber-400 text-xs mt-2">
                        @string.Format(CultureInfo.CurrentCulture, Resources["Pob_Unmapped"].Value, result.UnmappedAffixes)
                    </TextBase>
                }

                @* 引擎自己的盲区：这条**不是**「我们没认出」，而是 PoB 标成「Not supported in PoB yet」的行。
                   必须逐条列出来 —— 否则用户会把 0 读成「这条词缀没贡献」，结论就错了。 *@
                @if (result.EngineUnsupportedCount > 0)
                {
                    <TextBase Class="text-amber-400 text-xs mt-2">
                        @string.Format(CultureInfo.CurrentCulture, Resources["Pob_Engine_Unsupported"].Value, result.EngineUnsupportedCount)
                    </TextBase>
                    @foreach (var line in result.EngineUnsupportedLines)
                    {
                        <TextBase Class="text-stone-500 text-xs">@AffixText(line)</TextBase>
                    }
                }

                @* 这条是硬要求：PoB 是模拟器，绝对值不能拿去对游戏面板，可信的是差值。 *@
                <TextBase Class="text-stone-500 text-xs mt-2">@Resources["Pob_Absolute_Caveat"]</TextBase>
                @if (elapsedMs > 0)
                {
                    <TextBase Class="text-stone-600 text-xs mt-1">
                        @string.Format(CultureInfo.CurrentCulture, Resources["Pob_Elapsed"].Value, elapsedMs)
                    </TextBase>
                }
            }
            else if (result != null)
            {
                <TextBase Class="text-stone-400 text-sm">@StatusText(result)</TextBase>
                @if (!string.IsNullOrWhiteSpace(result.Error) && result.Status != PobCompareStatus.BaseUnknown)
                {
                    <TextBase Class="text-stone-600 text-xs mt-1">@result.Error</TextBase>
                }
            }
        </FormFieldset>
    </div>

    @* C2b：这件装备上每条词缀各自值多少（口径 = 把它拿掉再算一次）。
       外层条件必须挡住「gains == null 且不在算」：服务契约就是「返回 null = 这一栏不该显示」，
       否则会给用户一个有标题、没内容、没解释的空框（审计 F）。 *@
    @if (gainsLoading || gains is { Rows.Count: > 0 })
    {
        <div class="mt-4">
            <FormFieldset Legend="@Resources["Affix_Gain_Title"]">
                @if (gainsLoading)
                {
                    <TextBase Class="text-stone-400 text-sm">@Resources["Pob_Working"]</TextBase>
                }
                else if (gains is { } gain)
                {
                    @if (gain.Top.Count > 0)
                    {
                        <table class="w-full text-sm border-collapse">
                            <thead>
                            <tr class="text-stone-500 text-xs text-left">
                                <th class="font-normal py-1">@Resources["Affix_Gain_Affix"]</th>
                                <th class="font-normal py-1 text-right">@Resources["Pob_Dps"]</th>
                                <th class="font-normal py-1 text-right">@Resources["Pob_Ehp"]</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in gain.Top)
                            {
                                <tr class="border-t border-stone-700">
                                    <td class="py-1">
                                        @AffixText(row.Text)
                                        @if (row.Implicit)
                                        {
                                            <span class="text-stone-500 text-xs">@Resources["Affix_Gain_Implicit"]</span>
                                        }
                                        @if (row.UnsupportedByEngine)
                                        {
                                            <span class="text-amber-400 text-xs">@Resources["Affix_Engine_Unsupported"]</span>
                                        }
                                    </td>
                                    @if (gain.DpsUnavailable)
                                    {
                                        @* 与上面那张表同一口径：算不出伤害时逐条 DPS 收益也没有数字，
                                           0 会被读成「这条词缀没贡献」。 *@
                                        <td class="py-1 text-right text-stone-500">—</td>
                                    }
                                    else
                                    {
                                        <td class="py-1 text-right @DeltaClass(row.DpsDelta)">@Signed(row.DpsDelta)@Pct(row.DpsPercent)</td>
                                    }
                                    <td class="py-1 text-right @DeltaClass(row.EhpDelta)">@Signed(row.EhpDelta)@Pct(row.EhpPercent)</td>
                                </tr>
                            }
                            </tbody>
                        </table>

                        @if (gain.DpsUnavailable)
                        {
                            <TextBase Class="text-amber-400 text-xs mt-2">@Resources["Pob_Dps_Unavailable"]</TextBase>
                        }
                    }

                    @if (gain.NotRanked.Count > 0)
                    {
                        <TextBase Class="text-amber-400 text-xs mt-2">
                            @string.Format(CultureInfo.CurrentCulture, Resources["Affix_Gain_Not_Computed"].Value, gain.NotRanked.Count)
                        </TextBase>
                        @foreach (var row in gain.NotRanked)
                        {
                            <TextBase Class="text-stone-500 text-xs">
                                @AffixText(row.Text) —— @AffixStatusText(row)
                            </TextBase>
                        }
                    }

                    @* 口径与「不可相加」这两句必须在**真算出数字**时才有意义；一条都没算出来时只给原因，不给口径。 *@
                    @if (gain.Top.Count > 0)
                    {
                        <TextBase Class="text-stone-500 text-xs mt-2">@Resources["Affix_Gain_Help"]</TextBase>
                        @if (gain.ElapsedMs > 0)
                        {
                            <TextBase Class="text-stone-600 text-xs mt-1">
                                @string.Format(CultureInfo.CurrentCulture, Resources["Affix_Gain_Elapsed"].Value, gain.Attempts, gain.ElapsedMs)
                            </TextBase>
                        }
                    }
                }
            </FormFieldset>
        </div>
    }
}

@inject IStringLocalizer<BuildTargetResources> Resources
@inject PobCompareService Compare
@inject PobAffixGainService Gains
@inject BuildTargetStore Store
@inject BuildTargetOptionsStore Options
@inject BuildTargetEvaluator Evaluator

@code {

    /// <summary>悬浮窗当前这件物品（ItemOverlay 已经用 CascadingValue 传下来）。</summary>
    [CascadingParameter]
    public required Item Item { get; set; }

    private PobCompareResult? result;
    private bool loading;
    private long elapsedMs;

    private AffixGainRanking? gains;
    private bool gainsLoading;

    private string? lastKey;

    /// <summary>
    /// 这件装备有没有踩到用户自己勾的硬性门槛（引擎指标判定的第 ① 条）。
    /// 复用非引擎那条轴的评估器拿数据，**不重写一套门槛匹配**。
    /// 评估失败就当没踩到 —— 宁可少给一个理由，也不编一个结论。
    /// </summary>
    private bool hardGateFailed;

    protected override void OnInitialized()
    {
        Store.OnChanged += OnStoreChanged;
        // 引擎开关在设置页拨动时本组件不会自动重算/重绘（审计 I）：订阅它，
        // 关掉时把面板收干净、打开时立刻重算当前这件物品。
        Options.OnChanged += OnStoreChanged;
        base.OnInitialized();
    }

    protected override async Task OnParametersSetAsync()
    {
        await RefreshAsync();
    }

    private void OnStoreChanged() => _ = InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    private async Task RefreshAsync()
    {
        if (!Options.PobEngine || Item == null)
        {
            result = null;
            gains = null;

            // ⚠ 必须连 key 一起清（审计 C）：否则「开着算过 → 关掉 → 再打开」之后，
            //   同一件物品会被 key 短路，面板永远只剩空框，直到换物品或换模板。
            lastKey = null;

            // 同时在飞的调用会按 key 复核丢弃、不会来清这两个转圈标记，
            // 顺手在这里收掉。守住的是「重新打开开关后面板别带着上一轮的状态起跑」——
            // 不是「不收就永远转圈」（早退时面板整块不渲染，起跑处也会再清一次）。
            loading = false;
            gainsLoading = false;
            return;
        }

        var template = Store.Active;
        var slotKey = SlotKeys.ResolveFor(Item).FirstOrDefault();

        // 同一件物品 + 同一个模板不重复算（组件会因父级重渲染被反复调用）。
        // key 里放**物品原文本身**（不用 GetHashCode）：哈希是 32 位，两件不同物品理论上会撞同一个 key，
        // 撞上就会短路成「显示另一件物品的数字」——又是一次静默说假话。整串比较成本一样。
        var key = $"{template?.Id}|{slotKey}|{Item.Text.Text}";
        if (key == lastKey)
        {
            return;
        }

        lastKey = key;
        loading = true;
        gains = null;
        // ⚠ 起跑处必须连 gainsLoading 一起收（第四轮审计 3.1，是本次守卫带出的窄窗口）：
        //   上一轮的收益还在算时被打断，老调用会按 key 丢弃、**不会**去清这个标记；
        //   而新一轮若算出「不是 HasDelta」（悬停珠宝 / 基底认不出 / 槽位不支持），
        //   整段收益分支根本不进 → 没人再清 → 一直停在「正在重算…」转圈。
        //   修之前，拨关再拨开（整块被 @if 门控、拨开时重建）、或切走标签页再切回来
        //   （@switch 那个分支移出渲染树、组件销毁），都会顺手收掉这一圈。
        gainsLoading = false;
        StateHasChanged();

        // 硬性门槛是**非引擎那条轴**的事，跟引擎算不算得出无关：在起跑处算一次，随结果一起给判定用。
        hardGateFailed = EvaluateHardGate(template, slotKey);

        try
        {
            var started = Environment.TickCount64;
            var measured = await Compare.CompareAsync(template, Item, slotKey);

            // ⚠ await 之后必须复核前提（审计第三轮 🟡-1，与备选篮 3-1 同一类毛病）：
            //   在算的窗口期内换模板 / 换物品 / 关开关时，lastKey 已经被下一轮改掉，
            //   这里照写就会让面板长期显示**上一个前提**的数字（界面说假话）。
            if (key != lastKey)
            {
                return;
            }

            result = measured;
            elapsedMs = Environment.TickCount64 - started;

            // 逐条词缀的收益要有个参照系（原物数值），所以只在对比算出来之后才跑。
            // 成本：1 + N 次试穿，热引擎约 15 ms/次。
            if (result is { HasDelta: true })
            {
                gainsLoading = true;
                StateHasChanged();

                try
                {
                    var ranked = await Gains.RankAsync(template, Item, slotKey);
                    if (key != lastKey)
                    {
                        return;
                    }

                    gains = ranked;
                }
                finally
                {
                    // 老的调用回来时不许把新一轮的转圈标记清掉（只能在前提还是自己时清）。
                    if (key == lastKey)
                    {
                        gainsLoading = false;
                    }
                }
            }
        }
        finally
        {
            // 同上：前提已经变了就交给新一轮去收，别把它的转圈标记提前清掉。
            if (key == lastKey)
            {
                loading = false;
            }
        }
    }

    /// <summary>
    /// 没算出来的那条词缀为什么没算（照抄对比面板的口径，别造第二套说法）。
    /// ⚠ 非引擎原因**不许说成「引擎出错」**（审计第二轮 3-3：运行中把引擎开关关掉会走到这里，
    /// 那时错误串还是空的，会显示成「引擎出错：-」——第一轮阻断同族的毛病）。
    /// </summary>
    private string AffixStatusText(AffixGainRow row) => row.Status switch
    {
        PobCompareStatus.AffixLost => Resources["Affix_Gain_No_Line"].Value,
        PobCompareStatus.Disabled => Resources["Pob_Disabled"].Value,
        PobCompareStatus.NoTemplate => Resources["Pob_No_Template"].Value,
        PobCompareStatus.NoBuildXml => Resources["Pob_No_Build"].Value,
        PobCompareStatus.UnsupportedSlot => Resources["Pob_Unsupported_Slot"].Value,
        PobCompareStatus.SocketedItem => Resources["Pob_Socketed_Item"].Value,
        PobCompareStatus.BaseUnknown => Resources["Pob_Base_Unknown"].Value,
        PobCompareStatus.ConversionFailed => Resources["Pob_Conversion_Failed"].Value,
        PobCompareStatus.EngineUnavailable => string.Format(CultureInfo.CurrentCulture, Resources["Pob_No_Engine"].Value, row.Error ?? "-"),
        _ => string.Format(CultureInfo.CurrentCulture, Resources["Pob_Failed"].Value, row.Error ?? "-"),
    };

    /// <summary>多行词缀在表格里必须显示成一行（真换行会把表格撑破），断点用「⏎」标出来 —— 顺便让用户看得见这是多行词缀。</summary>
    private static string AffixText(string text) => text.Replace("\n", " ⏎ ");

    /// <summary>
    /// 「本次用的伤害指标是 …」那一行。**只在不是默认的 TotalDPS 时才显示**：
    /// 默认路径本来就不该多一行字；回退到 Combined/Full 时必须说清楚 ——
    /// 否则用户会拿两个不同口径的绝对值互相对照。
    /// </summary>
    private string? PrimaryMetricText(PobCompareResult value)
    {
        if (value.DpsUnavailable ||
            string.IsNullOrEmpty(value.PrimaryMetricKey) ||
            value.PrimaryMetricKey == PobPrimaryMetric.TotalDps)
        {
            return null;
        }

        return string.Format(
            CultureInfo.CurrentCulture,
            Resources["Pob_Primary_Metric"].Value,
            PobPrimaryMetric.DisplayName(value.PrimaryMetricKey));
    }

    /// <summary>当前评估场景（设置里那份）：切换后**下次载入生效**，这里如实显示设置值。</summary>
    private string ContextText() => string.Format(
        CultureInfo.CurrentCulture,
        Resources["Pob_Context"].Value,
        Resources[PobContexts.ResourceKey(Options.PobContext)].Value);

    /// <summary>
    /// 引擎指标判定（相对当前装备）。输入的两个百分比都来自这一次试穿对比；
    /// 硬性门槛与抗性守门分别由 <see cref="BuildTargetEvaluator"/> 与
    /// <see cref="ResistanceGuardrail"/> 提供 —— 判定本身只有 <see cref="ItemVerdictDecider"/> 一处。
    /// </summary>
    private EngineVerdictView EngineVerdictOf(PobCompareResult value)
    {
        var (verdict, reasonKey) = ItemVerdictDecider.Decide(ItemVerdictInput.From(value, hardGateFailed));

        return new EngineVerdictView(
            EngineVerdictClass(verdict),
            string.Format(
                CultureInfo.CurrentCulture,
                Resources["Pob_Verdict_Label"].Value,
                Resources["EngineVerdict_" + verdict].Value),
            // 理由**一定要显示**（尤其是 Unresolved：只丢一个「算不了」等于把原因藏起来）。
            Resources[reasonKey].Value);
    }

    /// <summary>判定那一行要显示的三段：配色 class / 「引擎判定：…」/ 理由小字。</summary>
    private sealed record EngineVerdictView(string Class, string Label, string Reason);

    /// <summary>判定的配色：<c>Unresolved</c> 特意用灰色（「算不了」不是结论，是缺信息）。</summary>
    private static string EngineVerdictClass(ItemVerdict verdict) => verdict switch
    {
        ItemVerdict.Unresolved => "text-stone-500",
        ItemVerdict.NoChange or ItemVerdict.Sidegrade => "text-stone-400",
        ItemVerdict.ClearUpgrade or ItemVerdict.StrongUpgrade
            or ItemVerdict.OffenseUpgrade or ItemVerdict.DefenseUpgrade => "text-green-400",
        ItemVerdict.Tradeoff => "text-amber-400",
        _ => "text-red-400",
    };

    /// <summary>
    /// 这件装备有没有踩到用户自己勾的硬性门槛。取不到（没模板 / 解析不了 / 不在槽位体系里）一律 false：
    /// 门槛这一条是「用户显式要求」才成立的，没证据就不许判它没过。
    /// </summary>
    private bool EvaluateHardGate(BuildTargetTemplate? template, string? slotKey)
    {
        if (template == null)
        {
            return false;
        }

        try
        {
            var evaluation = Evaluator.Evaluate(template, Item);
            var slot = evaluation.Slots.FirstOrDefault(x => x.SlotKey == slotKey)
                       ?? evaluation.Slots.FirstOrDefault();

            return slot?.HardGateFailed == true;
        }
        catch
        {
            return false;
        }
    }

    private string StatusText(PobCompareResult value) => value.Status switch
    {
        PobCompareStatus.Disabled => Resources["Pob_Disabled"].Value,
        PobCompareStatus.NoTemplate => Resources["Pob_No_Template"].Value,
        PobCompareStatus.NoBuildXml => Resources["Pob_No_Build"].Value,
        PobCompareStatus.UnsupportedSlot => Resources["Pob_Unsupported_Slot"].Value,
        PobCompareStatus.SocketedItem => Resources["Pob_Socketed_Item"].Value,
        PobCompareStatus.EngineUnavailable => string.Format(CultureInfo.CurrentCulture, Resources["Pob_No_Engine"].Value, value.Error ?? "-"),
        PobCompareStatus.BaseUnknown => Resources["Pob_Base_Unknown"].Value,
        PobCompareStatus.ConversionFailed => Resources["Pob_Conversion_Failed"].Value,
        _ => string.Format(CultureInfo.CurrentCulture, Resources["Pob_Failed"].Value, value.Error ?? "-"),
    };

    /// <summary>大数字加千分位（DPS 动辄七位数，不分组根本看不出量级）。</summary>
    private static string Num(double value) => value.ToString("#,0", CultureInfo.InvariantCulture);

    private static string Signed(double value) => (value >= 0 ? "+" : "") + value.ToString("#,0", CultureInfo.InvariantCulture);

    private static string Pct(double? percent) => percent is { } p ? $" ({p:+0.0;-0.0}%)" : "";

    /// <summary>涨绿跌红（与查价那套配色一致，用户已核对过）。</summary>
    private static string DeltaClass(double value) => value > 0 ? "text-green-400" : value < 0 ? "text-red-400" : "text-stone-400";

    public void Dispose()
    {
        Store.OnChanged -= OnStoreChanged;
        Options.OnChanged -= OnStoreChanged;
    }
}
