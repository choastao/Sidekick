@implements IDisposable
@using System.Globalization
@using Sidekick.Game.Parser.Items

@* PoB2 引擎试穿对比：只在「开关打开 + 有目标BD + 这件物品算得了」时给数字。 *@
@if (Options.PobEngine && Item != null)
{
    <div class="mt-4">
        <FormFieldset Legend="@Resources["Pob_Title"]">

            @if (loading)
            {
                <TextBase Class="text-stone-400 text-sm">@Resources["Pob_Working"]</TextBase>
            }
            else if (result is { HasDelta: true })
            {
                <table class="w-full text-sm border-collapse">
                    <thead>
                    <tr class="text-stone-500 text-xs text-left">
                        <th class="font-normal py-1"></th>
                        <th class="font-normal py-1 text-right">@Resources["Pob_Before"]</th>
                        <th class="font-normal py-1 text-right">@Resources["Pob_After"]</th>
                        <th class="font-normal py-1 text-right">@Resources["Pob_Delta"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr class="border-t border-stone-700">
                        <td class="py-1">@Resources["Pob_Dps"]</td>
                        <td class="py-1 text-right text-stone-400">@Num(result.Base!.Dps)</td>
                        <td class="py-1 text-right">@Num(result.Current!.Dps)</td>
                        <td class="py-1 text-right @DeltaClass(result.DpsDelta)">@Signed(result.DpsDelta)@Pct(result.DpsPercent)</td>
                    </tr>
                    <tr class="border-t border-stone-700">
                        <td class="py-1">@Resources["Pob_Ehp"]</td>
                        <td class="py-1 text-right text-stone-400">@Num(result.Base!.Ehp)</td>
                        <td class="py-1 text-right">@Num(result.Current!.Ehp)</td>
                        <td class="py-1 text-right @DeltaClass(result.EhpDelta)">@Signed(result.EhpDelta)@Pct(result.EhpPercent)</td>
                    </tr>
                    </tbody>
                </table>

                @if (result.UnmappedAffixes > 0)
                {
                    <TextBase Class="text-amber-400 text-xs mt-2">
                        @string.Format(CultureInfo.CurrentCulture, Resources["Pob_Unmapped"].Value, result.UnmappedAffixes)
                    </TextBase>
                }

                @* 这条是硬要求：PoB 是模拟器，绝对值不能拿去对游戏面板，可信的是差值。 *@
                <TextBase Class="text-stone-500 text-xs mt-2">@Resources["Pob_Absolute_Caveat"]</TextBase>
                @if (elapsedMs > 0)
                {
                    <TextBase Class="text-stone-600 text-xs mt-1">
                        @string.Format(CultureInfo.CurrentCulture, Resources["Pob_Elapsed"].Value, elapsedMs)
                    </TextBase>
                }
            }
            else if (result != null)
            {
                <TextBase Class="text-stone-400 text-sm">@StatusText(result)</TextBase>
                @if (!string.IsNullOrWhiteSpace(result.Error) && result.Status != PobCompareStatus.BaseUnknown)
                {
                    <TextBase Class="text-stone-600 text-xs mt-1">@result.Error</TextBase>
                }
            }
        </FormFieldset>
    </div>

    @* C2b：这件装备上每条词缀各自值多少（口径 = 把它拿掉再算一次）。 *@
    <div class="mt-4">
        <FormFieldset Legend="@Resources["Affix_Gain_Title"]">
            @if (gainsLoading)
            {
                <TextBase Class="text-stone-400 text-sm">@Resources["Pob_Working"]</TextBase>
            }
            else if (gains is { Top.Count: > 0 })
            {
                <table class="w-full text-sm border-collapse">
                    <thead>
                    <tr class="text-stone-500 text-xs text-left">
                        <th class="font-normal py-1">@Resources["Affix_Gain_Affix"]</th>
                        <th class="font-normal py-1 text-right">@Resources["Pob_Dps"]</th>
                        <th class="font-normal py-1 text-right">@Resources["Pob_Ehp"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in gains.Top)
                    {
                        <tr class="border-t border-stone-700">
                            <td class="py-1">
                                @row.Text
                                @if (row.Implicit)
                                {
                                    <span class="text-stone-500 text-xs">@Resources["Affix_Gain_Implicit"]</span>
                                }
                            </td>
                            <td class="py-1 text-right @DeltaClass(row.DpsDelta)">@Signed(row.DpsDelta)@Pct(row.DpsPercent)</td>
                            <td class="py-1 text-right @DeltaClass(row.EhpDelta)">@Signed(row.EhpDelta)@Pct(row.EhpPercent)</td>
                        </tr>
                    }
                    </tbody>
                </table>

                @if (gains.NotRanked.Count > 0)
                {
                    <TextBase Class="text-amber-400 text-xs mt-2">
                        @string.Format(CultureInfo.CurrentCulture, Resources["Affix_Gain_Not_Computed"].Value, gains.NotRanked.Count)
                    </TextBase>
                    @foreach (var row in gains.NotRanked)
                    {
                        <TextBase Class="text-stone-500 text-xs">
                            @row.Text —— @AffixStatusText(row)
                        </TextBase>
                    }
                }

                @* 口径与「不可相加」这两句必须都写：前者防误解成「洗到顶档能涨多少」，后者防用户把几条加起来。 *@
                <TextBase Class="text-stone-500 text-xs mt-2">@Resources["Affix_Gain_Help"]</TextBase>
                @if (gains.ElapsedMs > 0)
                {
                    <TextBase Class="text-stone-600 text-xs mt-1">
                        @string.Format(CultureInfo.CurrentCulture, Resources["Affix_Gain_Elapsed"].Value, gains.Rows.Count, gains.ElapsedMs)
                    </TextBase>
                }
            }
        </FormFieldset>
    </div>
}

@inject IStringLocalizer<BuildTargetResources> Resources
@inject PobCompareService Compare
@inject PobAffixGainService Gains
@inject BuildTargetStore Store
@inject BuildTargetOptionsStore Options

@code {

    /// <summary>悬浮窗当前这件物品（ItemOverlay 已经用 CascadingValue 传下来）。</summary>
    [CascadingParameter]
    public required Item Item { get; set; }

    private PobCompareResult? result;
    private bool loading;
    private long elapsedMs;

    private AffixGainRanking? gains;
    private bool gainsLoading;

    private string? lastKey;

    protected override void OnInitialized()
    {
        Store.OnChanged += OnStoreChanged;
        base.OnInitialized();
    }

    protected override async Task OnParametersSetAsync()
    {
        await RefreshAsync();
    }

    private void OnStoreChanged() => _ = InvokeAsync(async () => await RefreshAsync());

    private async Task RefreshAsync()
    {
        if (!Options.PobEngine || Item == null)
        {
            result = null;
            gains = null;
            return;
        }

        var template = Store.Active;
        var slotKey = SlotKeys.ResolveFor(Item).FirstOrDefault();

        // 同一件物品 + 同一个模板不重复算（组件会因父级重渲染被反复调用）。
        var key = $"{template?.Id}|{slotKey}|{Item.Text.Text?.GetHashCode()}";
        if (key == lastKey)
        {
            return;
        }

        lastKey = key;
        loading = true;
        gains = null;
        StateHasChanged();

        try
        {
            var started = Environment.TickCount64;
            result = await Compare.CompareAsync(template, Item, slotKey);
            elapsedMs = Environment.TickCount64 - started;

            // 逐条词缀的收益要有个参照系（原物数值），所以只在对比算出来之后才跑。
            // 成本：1 + N 次试穿，热引擎约 15 ms/次。
            if (result is { HasDelta: true })
            {
                gainsLoading = true;
                StateHasChanged();

                try
                {
                    gains = await Gains.RankAsync(template, Item, slotKey);
                }
                finally
                {
                    gainsLoading = false;
                }
            }
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>没算出来的那条词缀为什么没算（照抄对比面板的口径，别造第二套说法）。</summary>
    private string AffixStatusText(AffixGainRow row) => row.Status switch
    {
        PobCompareStatus.EngineUnavailable => string.Format(CultureInfo.CurrentCulture, Resources["Pob_No_Engine"].Value, row.Error ?? "-"),
        _ => string.Format(CultureInfo.CurrentCulture, Resources["Pob_Failed"].Value, row.Error ?? "-"),
    };

    private string StatusText(PobCompareResult value) => value.Status switch
    {
        PobCompareStatus.Disabled => Resources["Pob_Disabled"].Value,
        PobCompareStatus.NoTemplate => Resources["Pob_No_Template"].Value,
        PobCompareStatus.NoBuildXml => Resources["Pob_No_Build"].Value,
        PobCompareStatus.UnsupportedSlot => Resources["Pob_Unsupported_Slot"].Value,
        PobCompareStatus.SocketedItem => Resources["Pob_Socketed_Item"].Value,
        PobCompareStatus.EngineUnavailable => string.Format(CultureInfo.CurrentCulture, Resources["Pob_No_Engine"].Value, value.Error ?? "-"),
        PobCompareStatus.BaseUnknown => Resources["Pob_Base_Unknown"].Value,
        PobCompareStatus.ConversionFailed => Resources["Pob_Conversion_Failed"].Value,
        _ => string.Format(CultureInfo.CurrentCulture, Resources["Pob_Failed"].Value, value.Error ?? "-"),
    };

    /// <summary>大数字加千分位（DPS 动辄七位数，不分组根本看不出量级）。</summary>
    private static string Num(double value) => value.ToString("#,0", CultureInfo.InvariantCulture);

    private static string Signed(double value) => (value >= 0 ? "+" : "") + value.ToString("#,0", CultureInfo.InvariantCulture);

    private static string Pct(double? percent) => percent is { } p ? $" ({p:+0.0;-0.0}%)" : "";

    /// <summary>涨绿跌红（与查价那套配色一致，用户已核对过）。</summary>
    private static string DeltaClass(double value) => value > 0 ? "text-green-400" : value < 0 ? "text-red-400" : "text-stone-400";

    public void Dispose()
    {
        Store.OnChanged -= OnStoreChanged;
    }
}
