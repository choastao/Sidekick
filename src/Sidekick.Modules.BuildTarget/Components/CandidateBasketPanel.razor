@using System.Globalization
@using Sidekick.Common.Settings
@using Sidekick.Game.Parser
@using Sidekick.Game.Parser.Items
@using Sidekick.Modules.BuildTarget.Models
@implements IDisposable

<FormFieldset Legend="@Resources["Tab_Basket"]">

    @* 0. 空篮子：直接告诉用户怎么把东西放进来 *@
    @if (Basket.Items.Count == 0)
    {
        <TextBase Class="text-stone-400 text-sm">
            @string.Format(CultureInfo.CurrentCulture, Resources["Basket_Empty"].Value, KeybindText)
        </TextBase>
    }
    else
    {
        @* 1. 明细表：勾选 | 名称 | 部位 | 火 冰 电 混 力 敏 智 | 移除 *@
        <table class="w-full text-sm border-collapse">
            <thead>
            <tr class="text-stone-400 text-left">
                <th class="font-normal py-1 w-8"></th>
                <th class="font-normal py-1">@Resources["Basket_Col_Name"]</th>
                <th class="font-normal py-1 w-16">@Resources["Basket_Col_Slot"]</th>
                @foreach (var stat in BasketStatExtensions.All)
                {
                    <th class="font-normal py-1 text-right w-12">@Resources[stat.ResourceKey()]</th>
                }
                <th class="font-normal py-1 text-right w-14"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var entry in Basket.Items)
            {
                <tr class="border-t border-stone-700">
                    <td class="py-1 align-top">
                        <FormCheckbox Dense="true"
                                      Value="@entry.Enabled"
                                      ValueChanged="@(value => SetEnabled(entry, value))"/>
                    </td>
                    <td class="py-1">
                        @entry.Name
                        @if (!string.IsNullOrWhiteSpace(entry.BaseType) && entry.BaseType != entry.Name)
                        {
                            <span class="text-stone-500 text-xs ml-1">@entry.BaseType</span>
                        }
                    </td>
                    <td class="py-1 text-stone-400">@SlotLabel(entry.SlotKey)</td>
                    @foreach (var stat in BasketStatExtensions.All)
                    {
                        <td class="py-1 text-right @(entry.Enabled ? string.Empty : "text-stone-600")">
                            @ItemValue(entry.Contribution.Get(stat))
                        </td>
                    }
                    <td class="py-1 text-right">
                        <ButtonLink OnClick="() => Basket.Remove(entry.Id)">@Resources["Remove"]</ButtonLink>
                    </td>
                </tr>
            }

            @* 合计行：只算勾选上的备选 *@
            <tr class="border-t-2 border-stone-600">
                <td class="py-1"></td>
                <td class="py-1 font-medium">@Resources["Basket_Total"]</td>
                <td class="py-1 text-stone-500 text-xs">
                    @string.Format(CultureInfo.CurrentCulture, Resources["Basket_Enabled_Count"].Value, EnabledCount, Basket.Items.Count)
                </td>
                @foreach (var stat in BasketStatExtensions.All)
                {
                    <td class="py-1 text-right font-medium">@Plain(Total.Get(stat))</td>
                }
                <td class="py-1"></td>
            </tr>
            </tbody>
        </table>

        @* 2. 结论：抗性够不够（✅ 达标 / ⚠️ 差 N，不用颜色当唯一信号）
             目标值优先取「目标BD → 角色总目标」里设的；没设过的才退回可调上限。*@
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
            @foreach (var stat in BasketStatExtensions.Resistances)
            {
                var value = Total.Get(stat);
                var bdTarget = CharacterTarget(stat);
                var target = bdTarget ?? Basket.ResistanceCap;
                var missing = target - value;
                var source = bdTarget.HasValue
                                 ? string.Format(CultureInfo.CurrentCulture, Resources["Basket_Target_FromBd"].Value, Plain(target))
                                 : string.Format(CultureInfo.CurrentCulture, Resources["Basket_Target_Default"].Value, Plain(target));
                var text = missing <= 0
                               ? $"{Resources[stat.ResourceKey()]} {Plain(value)} {Resources["Basket_Cap_Ok"]}{source}"
                               : $"{Resources[stat.ResourceKey()]} {Plain(value)} {string.Format(CultureInfo.CurrentCulture, Resources["Basket_Cap_Short"].Value, Plain(missing))}{source}";

                <TextBase Class="@($"text-sm {(missing <= 0 ? "text-green-400" : "text-amber-400")}")">@text</TextBase>
            }
        </div>
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Target_Note"]</TextBase>

        @* 3. 属性区：装备提供的属性加值合计 *@
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
            @foreach (var stat in BasketStatExtensions.Attributes)
            {
                <TextBase Class="text-sm text-stone-300">@AttributeLabel(stat) @Delta(Total.Get(stat))</TextBase>
            }
        </div>
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Attribute_Note"]</TextBase>

        @* 4. 有当前装备快照的部位：替换前后对比 *@
        @if (Comparisons.Count == 0)
        {
            <TextBase Class="mt-3 text-stone-500 text-xs">@Resources["Basket_No_Snapshot"]</TextBase>
        }
        else
        {
            <TextBase Class="mt-3 text-sm font-medium text-stone-400">@Resources["Basket_Compare_Title"]</TextBase>
            @foreach (var comparison in Comparisons)
            {
                <TextBase Class="text-stone-400 text-xs">
                    @string.Format(CultureInfo.CurrentCulture, Resources["Basket_Compare_Slot"].Value, SlotLabel(comparison.SlotKey), comparison.CurrentName)
                </TextBase>
                @if (comparison.Current.IsEmpty)
                {
                    @* 快照解析出来了但一个抗性/属性都没有（常见于导入 BD 的英文物品文本）：如实说，别让人以为「换上去白赚」*@
                    <TextBase Class="text-amber-400 text-xs">@Resources["Basket_Compare_Unparsable"]</TextBase>
                }
                <div class="flex flex-wrap gap-x-4 gap-y-1">
                    @foreach (var stat in BasketStatExtensions.All)
                    {
                        var before = comparison.Current.Get(stat);
                        var after = comparison.Next.Get(stat);
                        if (before == 0 && after == 0)
                        {
                            continue;
                        }

                        <TextBase Class="text-sm text-stone-300">
                            @StatLabel(stat) @Plain(before) → @Plain(after)（@Delta(after - before)）
                        </TextBase>
                    }
                </div>
            }
        }

        <div class="mt-3">
            <ButtonSecondary OnClick="Basket.Clear">@Resources["Basket_Clear"]</ButtonSecondary>
        </div>
    }

    @* 5. 抗性上限：可改（+最大抗性 / 升华都会动它）*@
    <div class="mt-3 flex flex-wrap items-end gap-3">
        <div class="w-40">
            <FormNumber Label="@Resources["Basket_Cap"]"
                        Value="@Basket.ResistanceCap"
                        ValueChanged="SetResistanceCap"
                        Min="0"
                        Max="200"/>
        </div>
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Cap_Note"]</TextBase>
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Cap_Note_Bd"]</TextBase>
    </div>

    @* 6. 诚实边界：一条都不能省 *@
    <div class="mt-3 flex flex-col gap-1">
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Note_Scope"]</TextBase>
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Note_AllEle"]</TextBase>
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Note_Additive"]</TextBase>
    </div>

    @* 7. 引擎排序（C2a）：把**勾选**的候选逐个试穿，按 DPS / EHP 的增减排名。
          排序指标切换只是本地重排（不重跑引擎）；没算出来的行照样列出并说明原因。 *@
    @if (Basket.Items.Count > 0 && Options.PobEngine)
    {
        <div class="mt-4">
            <TextBase Class="text-sm font-medium text-stone-400">@Resources["Basket_Rank_Title"]</TextBase>

            @if (rankBusy)
            {
                <TextBase Class="text-stone-400 text-sm mt-1">@Resources["Basket_Rank_Running"]</TextBase>
            }
            else if (ranking == null)
            {
                <div class="mt-1 flex flex-wrap items-center gap-2">
                    <ButtonSecondary OnClick="RankAsync">@Resources["Basket_Rank_Start"]</ButtonSecondary>
                    <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Rank_Note"]</TextBase>
                </div>
            }
            else
            {
                <div class="mt-1 flex flex-wrap items-center gap-3">
                    <ButtonLink OnClick="@(() => SetMetric(CandidateRankMetric.Dps))">@Resources["Basket_Rank_By_Dps"]</ButtonLink>
                    <ButtonLink OnClick="@(() => SetMetric(CandidateRankMetric.Ehp))">@Resources["Basket_Rank_By_Ehp"]</ButtonLink>
                    <ButtonSecondary OnClick="RankAsync">@Resources["Basket_Rank_Again"]</ButtonSecondary>
                    <TextBase Class="text-stone-500 text-xs">
                        @string.Format(CultureInfo.CurrentCulture, Resources["Basket_Rank_Count"].Value, ranking.Ranked.Count, ranking.Rows.Count)
                    </TextBase>
                    <TextBase Class="text-stone-400 text-xs">@MetricText(ranking.Metric)</TextBase>
                </div>

                <table class="w-full text-sm border-collapse mt-2">
                    <thead>
                    <tr class="text-stone-500 text-xs text-left">
                        <th class="font-normal py-1 w-8">#</th>
                        <th class="font-normal py-1">@Resources["Basket_Col_Name"]</th>
                        <th class="font-normal py-1 w-16">@Resources["Basket_Col_Slot"]</th>
                        <th class="font-normal py-1 text-right w-28">@Resources["Pob_Dps"]</th>
                        <th class="font-normal py-1 text-right w-28">@Resources["Pob_Ehp"]</th>
                        <th class="font-normal py-1 w-24"></th>
                        <th class="font-normal py-1"></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in ranking.Rows)
                    {
                        <tr class="border-t border-stone-700">
                            <td class="py-1 text-stone-400">@Rank(row)</td>
                            <td class="py-1">
                                @row.Name
                                @if (!string.IsNullOrWhiteSpace(row.BaseType) && row.BaseType != row.Name)
                                {
                                    <span class="text-stone-500 text-xs ml-1">@row.BaseType</span>
                                }
                            </td>
                            <td class="py-1 text-stone-400">@SlotLabel(row.SlotKey)</td>
                            @if (row.IsRanked)
                            {
                                @if (row.DpsUnavailable)
                                {
                                    @* 引擎算不出这份 BD 的伤害：显示「—」而不是 0 ——
                                       0 会被读成「这件没变化」，与「算不出来」是两种相反的结论。 *@
                                    <td class="py-1 text-right text-stone-500">—</td>
                                }
                                else
                                {
                                    <td class="py-1 text-right @DeltaClass(row.DpsDelta)">@Signed(row.DpsDelta)@Percent(row.DpsPercent)</td>
                                }
                                <td class="py-1 text-right @DeltaClass(row.EhpDelta)">@Signed(row.EhpDelta)@Percent(row.EhpPercent)</td>
                            }
                            else
                            {
                                <td class="py-1 text-right text-stone-600">—</td>
                                <td class="py-1 text-right text-stone-600">—</td>
                            }
                            <td class="py-1 whitespace-nowrap">
                                @* C2c：按需算这一件候选的逐条词缀收益（点开才跑引擎，不白烧）。 *@
                                @if (row.IsRanked || gains.ContainsKey(row.Id))
                                {
                                    <ButtonLink OnClick="@(() => ToggleGainsAsync(row))">@Resources["Basket_Gains_Button"]</ButtonLink>
                                }
                            </td>
                            <td class="py-1 text-xs text-amber-400">
                                @RankNote(row)
                            </td>
                        </tr>

                        @if (expandedId == row.Id)
                        {
                            <tr>
                                <td colspan="7" class="py-2 pl-6 border-t border-stone-800">
                                    @if (gainsBusy.Contains(row.Id))
                                    {
                                        <TextBase Class="text-stone-400 text-sm">@Resources["Basket_Gains_Running"]</TextBase>
                                    }
                                    else if (gains.TryGetValue(row.Id, out var gain) && gain is { } ranking_)
                                    {
                                        @if (ranking_.Top.Count > 0)
                                        {
                                            <table class="w-full text-sm border-collapse">
                                                <thead>
                                                <tr class="text-stone-500 text-xs text-left">
                                                    <th class="font-normal py-1">@Resources["Affix_Gain_Affix"]</th>
                                                    <th class="font-normal py-1 text-right w-28">@Resources["Pob_Dps"]</th>
                                                    <th class="font-normal py-1 text-right w-28">@Resources["Pob_Ehp"]</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                @foreach (var affix in ranking_.Top)
                                                {
                                                    <tr class="border-t border-stone-800">
                                                        <td class="py-1">
                                                            @AffixText(affix.Text)
                                                            @if (affix.Implicit)
                                                            {
                                                                <span class="text-stone-500 text-xs">@Resources["Affix_Gain_Implicit"]</span>
                                                            }
                                                            @if (affix.UnsupportedByEngine)
                                                            {
                                                                <span class="text-amber-400 text-xs">@Resources["Affix_Engine_Unsupported"]</span>
                                                            }
                                                        </td>
                                                        @if (ranking_.DpsUnavailable)
                                                        {
                                                            @* 同上：逐条收益的 DPS 列也没有数字（与悬浮窗那份同一口径）。 *@
                                                            <td class="py-1 text-right text-stone-500">—</td>
                                                        }
                                                        else
                                                        {
                                                            <td class="py-1 text-right @DeltaClass(affix.DpsDelta)">@Signed(affix.DpsDelta)@Percent(affix.DpsPercent)</td>
                                                        }
                                                        <td class="py-1 text-right @DeltaClass(affix.EhpDelta)">@Signed(affix.EhpDelta)@Percent(affix.EhpPercent)</td>
                                                    </tr>
                                                }
                                                </tbody>
                                            </table>
                                        }

                                        @* 没算出来的照样逐条列出来（与悬浮窗那份一致）——只给条数等于把原因藏起来。 *@
                                        @if (ranking_.NotRanked.Count > 0)
                                        {
                                            <TextBase Class="text-amber-400 text-xs mt-1">
                                                @string.Format(CultureInfo.CurrentCulture, Resources["Affix_Gain_Not_Computed"].Value, ranking_.NotRanked.Count)
                                            </TextBase>
                                            @foreach (var affix in ranking_.NotRanked)
                                            {
                                                <TextBase Class="text-stone-500 text-xs">
                                                    @AffixText(affix.Text) —— @AffixStatusText(affix)
                                                </TextBase>
                                            }
                                        }

                                        @if (ranking_.Top.Count > 0)
                                        {
                                            @* 口径与「不可相加」两句与悬浮窗那份完全一致（别造第二套说法）。 *@
                                            <TextBase Class="text-stone-500 text-xs mt-1">@Resources["Affix_Gain_Help"]</TextBase>
                                            @if (ranking_.ElapsedMs > 0)
                                            {
                                                <TextBase Class="text-stone-600 text-xs">
                                                    @string.Format(CultureInfo.CurrentCulture, Resources["Affix_Gain_Elapsed"].Value, ranking_.Attempts, ranking_.ElapsedMs)
                                                </TextBase>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <TextBase Class="text-stone-500 text-sm">@Resources["Basket_Gains_None"]</TextBase>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>

                <TextBase Class="text-stone-500 text-xs mt-1">@Resources["Basket_Rank_Caveat"]</TextBase>
            }
        </div>
    }
</FormFieldset>


@inject IStringLocalizer<BuildTargetResources> Resources
@inject CandidateBasketService Basket
@inject BuildTargetStore Store
@inject ItemParser ItemParser
@inject ISettingsService SettingsService
@inject PobCandidateRanker Ranker
@inject PobAffixGainService Gains
@inject BuildTargetOptionsStore Options

@code {

    private string KeybindText { get; set; } = "Ctrl+B";

    /// <summary>最近一次引擎排序的结果（null = 还没排过）。</summary>
    private CandidateRanking? ranking;

    private bool rankBusy;

    /// <summary>
    /// C2c：按行 id 缓存的「逐条词缀收益」。**字典里有键**表示算过（值可能是 null = 这条算不了），
    /// 这样重复点开不会白跑一遍引擎；null 也缓存，否则「算不了」的行每点一次都要再试一次。
    /// </summary>
    private readonly Dictionary<string, AffixGainRanking?> gains = new();

    /// <summary>
    /// 正在算的行 id 集合。**用集合而不是单个 id**：用户可以连点两行，两行会串行占引擎闸；
    /// 若只记一个 id，先结束的那行会把状态清成「没在算」，于是**还在算的那行**会落到
    /// 「这条算不了」的分支（审计 E：显示的是一条不成立的结论）。
    /// </summary>
    private readonly HashSet<string> gainsBusy = new();

    /// <summary>当前展开的是哪一行（同一时刻只展开一行，避免表格无限长）。</summary>
    private string? expandedId;

    /// <summary>上一次排名所用模板的 id（换模板时用来判断「表里的数字是不是旧前提」）。</summary>
    private string? rankedTemplateId;

    private BasketContribution Total { get; set; } = new();

    private List<BasketComparison> Comparisons { get; set; } = [];

    private int EnabledCount => Basket.Items.Count(x => x.Enabled);

    protected override async Task OnInitializedAsync()
    {
        Basket.OnChanged += OnChanged;
        Store.OnChanged += OnChanged;
        // 引擎开关拨动时本组件不重绘（审计 I）——订阅它（板块的显示/隐藏条件就在 Options.PobEngine 上）。
        Options.OnChanged += OnChanged;

        var keybind = await SettingsService.GetString(SettingKeys.KeyAddToBasket);
        if (!string.IsNullOrWhiteSpace(keybind))
        {
            KeybindText = keybind;
        }

        Refresh();

        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        Refresh();
        base.OnParametersSet();
    }

    private void OnChanged()
    {
        // Refresh 会读写组件状态（Total / Comparisons）并枚举 Basket.Items，
        // 而 OnChanged 是在调用方线程上触发的（快捷键入篮 = 后台线程）。
        // 必须整体回 UI 线程 —— 之前只把 StateHasChanged 包进 InvokeAsync，
        // 前半段等于在后台线程改组件状态。审计（2026-09-19）发现。
        _ = InvokeAsync(() =>
        {
            // ⚠ 换了「目标BD」之后，上一次的排名与逐条收益都是**旧前提**下算的数字（审计 B）：
            //   C2b 侧靠 key 里的模板 id 自动失效，这里必须自己清，否则表里会同时出现两种前提的数字。
            var activeId = Store.Active?.Id;
            if (activeId != rankedTemplateId)
            {
                rankedTemplateId = activeId;
                ranking = null;
                ResetGains();
            }

            Refresh();
            StateHasChanged();
        });
    }

    /// <summary>重算合计 + 需要做替换对比的部位。</summary>
    private void Refresh()
    {
        Total = CandidateBasketCalculator.Sum(Basket.Items);
        Comparisons = BuildComparisons();
    }

    /// <summary>
    /// 只有在「目标BD」里给该部位采过当前装备快照时，才能算替换前后。
    /// 快照是物品原文，这里用同一套解析器解析后再折算，和 Basket 里的算法完全一致。
    /// </summary>
    private List<BasketComparison> BuildComparisons()
    {
        var result = new List<BasketComparison>();

        var equipped = Store.Active?.Equipped;
        if (equipped == null)
        {
            return result;
        }

        foreach (var slotKey in Basket.Items.Select(x => x.SlotKey).Distinct())
        {
            if (!equipped.TryGetValue(slotKey, out var snapshotText) || string.IsNullOrWhiteSpace(snapshotText))
            {
                continue;
            }

            var enabled = Basket.Items.Where(x => x.SlotKey == slotKey && x.Enabled).ToList();
            if (enabled.Count == 0)
            {
                continue;
            }

            Item? snapshot;
            try
            {
                snapshot = ItemParser.ParseItem(snapshotText);
            }
            catch
            {
                // 快照解析不了（多是导入 BD 的英文物品文本）：不猜，跳过这个部位
                continue;
            }

            var next = new BasketContribution();
            foreach (var entry in enabled)
            {
                next.Add(entry.Contribution);
            }

            result.Add(new BasketComparison
            {
                SlotKey = slotKey,
                CurrentName = snapshot.Name ?? snapshot.Type ?? slotKey,
                Current = CandidateBasketCalculator.Contribute(snapshot),
                Next = next,
            });
        }

        return result;
    }

    private void SetEnabled(CandidateBasketItem entry, bool enabled) => Basket.SetEnabled(entry.Id, enabled);

    private void SetResistanceCap(double? value) => Basket.ResistanceCap = value ?? 75;

    // ---- C2a：引擎排序 ----

    /// <summary>
    /// 把**勾选**的候选逐个交给引擎试穿并排名。未勾选的不算 —— 用户可能是特意把不想要的留在篮子里做参照。
    /// 引擎级失败（没装/崩了）时 <see cref="PobCandidateRanker"/> 会提前收尾，已算出来的名次保留。
    /// </summary>
    private async Task RankAsync()
    {
        if (rankBusy)
        {
            return;
        }

        var template = Store.Active;
        var candidates = Basket.Items.Where(x => x.Enabled).ToList();
        if (template == null || candidates.Count == 0)
        {
            return;
        }

        // 记住用户选的指标，重排后不跳回默认
        var metric = ranking?.Metric ?? CandidateRankMetric.Dps;

        rankBusy = true;
        ranking = null;
        rankedTemplateId = template.Id;   // 记下这批数字用的是哪个模板
        ResetGains();   // 列表要重算了，之前按行缓存的逐条收益不再对应当前这批行
        StateHasChanged();

        try
        {
            var result = await Ranker.RankAsync(template, candidates, metric);

            // ⚠ await 之后必须复核前提（审计第二轮 3-1）：这批引擎调用在飞行途中，用户可能已经切了「目标BD」，
            //   而 OnChanged 那时已经清过表；把旧前提的结果写回去会让表里同时出现两套前提的数字，
            //   而且因为 rankedTemplateId 已被更新，之后再也不会被自动清掉（只能手动重排）。
            if (template.Id != Store.Active?.Id)
            {
                return;
            }

            ranking = result;
        }
        finally
        {
            rankBusy = false;
        }
    }

    /// <summary>切换排序指标：本地重排即可，**不重跑引擎**（数字已经拿到了）。</summary>
    private void SetMetric(CandidateRankMetric metric)
    {
        if (ranking == null || ranking.Metric == metric)
        {
            return;
        }

        ranking = CandidateRanking.Sort(ranking.Rows, metric);
    }

    // ---- C2c：把 C2b 的「逐条词缀收益」按需接进篮子的排序结果 ----

    /// <summary>
    /// 点开 / 收起某一行的词缀收益。**只有点开才跑引擎**（一件候选 = 原物 1 次 + 每条词缀 1 次试穿，
    /// 每件约百来毫秒）—— 篮子里可能十几件候选，全部预跑会白烧掉几千次试穿里的大部分。
    /// </summary>
    private async Task ToggleGainsAsync(CandidateRankRow row)
    {
        if (expandedId == row.Id)
        {
            expandedId = null;
            return;
        }

        expandedId = row.Id;

        if (gains.ContainsKey(row.Id))
        {
            return;   // 算过了（哪怕是「算不了」，也缓存）→ 不再跑一遍引擎
        }

        var entry = Basket.Items.FirstOrDefault(x => x.Id == row.Id);
        var templateId = Store.Active?.Id;

        gainsBusy.Add(row.Id);
        StateHasChanged();

        try
        {
            var result = await LoadGainsAsync(entry);

            // 同 3-1：await 期间换了「目标BD」就把这次结果丢掉（不写进缓存），
            // 否则旧模板的数字会「复活」在切换后的表里。清也要连忙碌标记一起清自己的那一条。
            if (templateId != Store.Active?.Id)
            {
                return;
            }

            gains[row.Id] = result;
        }
        finally
        {
            // 只清自己这一行（连点两行时，另一行还在算，不能把它的忙碌状态清掉）
            gainsBusy.Remove(row.Id);
        }
    }

    /// <summary>
    /// 用**这一件候选自己的原文**去算逐条词缀收益（与 C2a 排序同一套口径：部位以物品自己解析出来的为准，
    /// 篮子里的 SlotKey 只当兜底）。算不了就返回 null，界面如实说「这条算不了」，不给 0。
    /// </summary>
    private async Task<AffixGainRanking?> LoadGainsAsync(CandidateBasketItem? entry)
    {
        var template = Store.Active;
        if (entry == null || template == null || string.IsNullOrWhiteSpace(entry.Text))
        {
            return null;
        }

        Item item;
        try
        {
            item = ItemParser.ParseItem(entry.Text);
        }
        catch
        {
            return null;
        }

        var slotKey = SlotKeys.ResolveFor(item).FirstOrDefault() ?? entry.SlotKey;
        return await Gains.RankAsync(template, item, slotKey);
    }

    /// <summary>篮子的组成变了（增删 / 勾选 / 换模板）→ 之前算好的逐条收益不再对应当前列表，丢掉。</summary>
    private void ResetGains()
    {
        gains.Clear();
        expandedId = null;
        gainsBusy.Clear();
    }

    private string Rank(CandidateRankRow row)
    {
        if (!row.IsRanked || ranking == null)
        {
            return "—";
        }

        var index = ranking.Ranked.ToList().IndexOf(row);
        return index < 0 ? "—" : (index + 1).ToString(CultureInfo.InvariantCulture);
    }

    /// <summary>行尾备注：算出来的把两个数分开说（我们没认出的 / 引擎不支持的），没算出来的说原因。</summary>
    private string RankNote(CandidateRankRow row)
    {
        if (!row.IsRanked)
        {
            return RankStatusText(row);
        }

        // 两个数分开说（与悬浮窗口径一致）：转换层的缺口是我们的锅，引擎的盲区是 PoB 的锅。
        var notes = new List<string>();

        // 伤害口径：算不出来时说明 DPS 这一列没有数字；回退到别的字段时说明用的是哪个数。
        // 文案与悬浮窗那份是同一套键，别在这里另造一套说法。
        if (row.DpsUnavailable)
        {
            notes.Add(Resources["Pob_Dps_Unavailable"].Value);
        }
        else if (!string.IsNullOrEmpty(row.PrimaryMetricKey) && row.PrimaryMetricKey != PobPrimaryMetric.TotalDps)
        {
            notes.Add(string.Format(
                CultureInfo.CurrentCulture,
                Resources["Pob_Primary_Metric"].Value,
                PobPrimaryMetric.DisplayName(row.PrimaryMetricKey)));
        }

        if (row.EngineUnsupportedLines.Count > 0)
        {
            notes.Add(string.Format(
                CultureInfo.CurrentCulture,
                Resources["Pob_Engine_Unsupported"].Value,
                row.EngineUnsupportedLines.Count));
        }

        if (row.UnmappedAffixes > 0)
        {
            notes.Add(string.Format(CultureInfo.CurrentCulture, Resources["Pob_Unmapped"].Value, row.UnmappedAffixes));
        }

        return string.Join("  ", notes);
    }

    private string RankStatusText(CandidateRankRow row) => row.Status switch
    {
        PobCompareStatus.MissingText => Resources["Pob_Missing_Text"].Value,
        PobCompareStatus.Disabled => Resources["Pob_Disabled"].Value,
        PobCompareStatus.NoTemplate => Resources["Pob_No_Template"].Value,
        PobCompareStatus.NoBuildXml => Resources["Pob_No_Build"].Value,
        PobCompareStatus.UnsupportedSlot => Resources["Pob_Unsupported_Slot"].Value,
        PobCompareStatus.SocketedItem => Resources["Pob_Socketed_Item"].Value,
        PobCompareStatus.BaseUnknown => Resources["Pob_Base_Unknown"].Value,
        PobCompareStatus.ConversionFailed => Resources["Pob_Conversion_Failed"].Value,
        PobCompareStatus.EngineUnavailable => string.Format(
            CultureInfo.CurrentCulture,
            Resources["Pob_No_Engine"].Value,
            row.Error ?? "-"),
        // 引擎原样带回的报错要说出来（审计第三轮 🟡-2）：只写「没有名次」会把原因吞掉，
        // 而同一件候选在 C2b/C2c 那两张表里是会显示「引擎出错：{msg}」的 —— 三处口径要一致。
        PobCompareStatus.Failed => string.Format(
            CultureInfo.CurrentCulture,
            Resources["Pob_Failed"].Value,
            row.Error ?? "-"),
        _ => Resources["Basket_Rank_Not_Ranked"].Value,
    };

    /// <summary>逐条词缀收益里「这条没算出来」的原因（与悬浮窗那份同一套说法；非引擎原因不许说成引擎出错）。</summary>
    private string AffixStatusText(AffixGainRow row) => row.Status switch
    {
        PobCompareStatus.AffixLost => Resources["Affix_Gain_No_Line"].Value,
        PobCompareStatus.Disabled => Resources["Pob_Disabled"].Value,
        PobCompareStatus.NoTemplate => Resources["Pob_No_Template"].Value,
        PobCompareStatus.NoBuildXml => Resources["Pob_No_Build"].Value,
        PobCompareStatus.UnsupportedSlot => Resources["Pob_Unsupported_Slot"].Value,
        PobCompareStatus.SocketedItem => Resources["Pob_Socketed_Item"].Value,
        PobCompareStatus.BaseUnknown => Resources["Pob_Base_Unknown"].Value,
        PobCompareStatus.ConversionFailed => Resources["Pob_Conversion_Failed"].Value,
        PobCompareStatus.EngineUnavailable => string.Format(
            CultureInfo.CurrentCulture,
            Resources["Pob_No_Engine"].Value,
            row.Error ?? "-"),
        _ => string.Format(CultureInfo.CurrentCulture, Resources["Pob_Failed"].Value, row.Error ?? "-"),
    };

    /// <summary>多行词缀在表格里显示成一行（真换行会把表格撑破），断点用「⏎」标出来。</summary>
    private static string AffixText(string text) => text.Replace("\n", " ⏎ ");

    private string MetricText(CandidateRankMetric metric) =>
        metric == CandidateRankMetric.Ehp
            ? Resources["Basket_Rank_By_Ehp"].Value
            : Resources["Basket_Rank_By_Dps"].Value;

    /// <summary>涨绿跌红（与查价那套配色一致，用户已核对过）。</summary>
    private static string DeltaClass(double value) =>
        value > 0 ? "text-green-400" : value < 0 ? "text-red-400" : "text-stone-400";

    private static string Signed(double value) =>
        (value >= 0 ? "+" : "") + value.ToString("#,0", CultureInfo.InvariantCulture);

    private static string Percent(double? percent) =>
        percent is { } value ? $" ({value.ToString("+0.0;-0.0", CultureInfo.InvariantCulture)}%)" : string.Empty;

    /// <summary>
    /// 备选篮里每个统计项，对应「目标BD → 角色总目标」里可能用的匹配词。
    /// 和 StatPresets.ForCharacterTargets() 用的是同一套关键词，两边不要各写一份。
    /// </summary>
    private static readonly Dictionary<BasketStat, string[]> TargetKeywords = new()
    {
        [BasketStat.FireResistance] = ["to Fire Resistance", "火焰抗性"],
        [BasketStat.ColdResistance] = ["to Cold Resistance", "冰冷抗性"],
        [BasketStat.LightningResistance] = ["to Lightning Resistance", "闪电抗性", "閃電抗性"],
        [BasketStat.ChaosResistance] = ["to Chaos Resistance", "混沌抗性"],
        [BasketStat.Strength] = ["to Strength", "力量"],
        [BasketStat.Dexterity] = ["to Dexterity", "敏捷"],
        [BasketStat.Intelligence] = ["to Intelligence", "智慧"],
    };

    /// <summary>
    /// 取该统计项在「角色总目标」里设的目标值；没设过返回 null（调用方退回抗性上限）。
    /// 硬性门槛（Required）优先于加分项，避免同一个词缀两条时取错。
    /// </summary>
    private double? CharacterTarget(BasketStat stat)
    {
        var character = Store.Active?.Character;
        if (character == null || character.Count == 0)
        {
            return null;
        }

        if (!TargetKeywords.TryGetValue(stat, out var keywords))
        {
            return null;
        }

        var matched = character.FirstOrDefault(t => t.Required && MatchesKeywords(t, keywords))
                   ?? character.FirstOrDefault(t => MatchesKeywords(t, keywords));

        return matched?.MinValue;
    }

    private static bool MatchesKeywords(ModTarget target, string[] keywords) =>
        target.Match.Any(pattern => keywords.Any(
            keyword => pattern.Contains(keyword, StringComparison.OrdinalIgnoreCase)));

    private string SlotLabel(string slotKey) =>
        slotKey == SlotKeys.Unknown ? Resources["Basket_Slot_Unknown"] : Resources["Slot_" + slotKey];

    private string StatLabel(BasketStat stat) => Resources[stat.ResourceKey()];

    private string AttributeLabel(BasketStat stat) => Resources["Basket_Attr_" + stat];

    /// <summary>明细表里的数值：没有贡献的显示 -，避免一屏 0。</summary>
    private static string ItemValue(double value) => value == 0 ? "-" : Plain(value);

    private static string Plain(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Delta(double value) => value > 0
                                                     ? "+" + value.ToString("0.##", CultureInfo.InvariantCulture)
                                                     : value.ToString("0.##", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        Basket.OnChanged -= OnChanged;
        Store.OnChanged -= OnChanged;
        Options.OnChanged -= OnChanged;
    }

    private class BasketComparison
    {
        public required string SlotKey { get; init; }

        public required string CurrentName { get; init; }

        /// <summary>该部位当前装备（快照）的贡献。</summary>
        public required BasketContribution Current { get; init; }

        /// <summary>该部位全部启用备选的贡献合计。</summary>
        public required BasketContribution Next { get; init; }
    }

}
