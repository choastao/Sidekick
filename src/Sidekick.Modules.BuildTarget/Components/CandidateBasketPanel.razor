@using System.Globalization
@using Sidekick.Common.Settings
@using Sidekick.Game.Parser
@using Sidekick.Game.Parser.Items
@using Sidekick.Modules.BuildTarget.Models
@implements IDisposable

<FormFieldset Legend="@Resources["Tab_Basket"]">

    @* 0. 空篮子：直接告诉用户怎么把东西放进来 *@
    @if (Basket.Items.Count == 0)
    {
        <TextBase Class="text-stone-400 text-sm">
            @string.Format(CultureInfo.CurrentCulture, Resources["Basket_Empty"].Value, KeybindText)
        </TextBase>
    }
    else
    {
        @* 1. 明细表：勾选 | 名称 | 部位 | 火 冰 电 混 力 敏 智 | 移除 *@
        <table class="w-full text-sm border-collapse">
            <thead>
            <tr class="text-stone-400 text-left">
                <th class="font-normal py-1 w-8"></th>
                <th class="font-normal py-1">@Resources["Basket_Col_Name"]</th>
                <th class="font-normal py-1 w-16">@Resources["Basket_Col_Slot"]</th>
                @foreach (var stat in BasketStatExtensions.All)
                {
                    <th class="font-normal py-1 text-right w-12">@Resources[stat.ResourceKey()]</th>
                }
                <th class="font-normal py-1 text-right w-14"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var entry in Basket.Items)
            {
                <tr class="border-t border-stone-700">
                    <td class="py-1 align-top">
                        <FormCheckbox Dense="true"
                                      Value="@entry.Enabled"
                                      ValueChanged="@(value => SetEnabled(entry, value))"/>
                    </td>
                    <td class="py-1">
                        @entry.Name
                        @if (!string.IsNullOrWhiteSpace(entry.BaseType) && entry.BaseType != entry.Name)
                        {
                            <span class="text-stone-500 text-xs ml-1">@entry.BaseType</span>
                        }
                    </td>
                    <td class="py-1 text-stone-400">@SlotLabel(entry.SlotKey)</td>
                    @foreach (var stat in BasketStatExtensions.All)
                    {
                        <td class="py-1 text-right @(entry.Enabled ? string.Empty : "text-stone-600")">
                            @ItemValue(entry.Contribution.Get(stat))
                        </td>
                    }
                    <td class="py-1 text-right">
                        <ButtonLink OnClick="() => Basket.Remove(entry.Id)">@Resources["Remove"]</ButtonLink>
                    </td>
                </tr>
            }

            @* 合计行：只算勾选上的备选 *@
            <tr class="border-t-2 border-stone-600">
                <td class="py-1"></td>
                <td class="py-1 font-medium">@Resources["Basket_Total"]</td>
                <td class="py-1 text-stone-500 text-xs">
                    @string.Format(CultureInfo.CurrentCulture, Resources["Basket_Enabled_Count"].Value, EnabledCount, Basket.Items.Count)
                </td>
                @foreach (var stat in BasketStatExtensions.All)
                {
                    <td class="py-1 text-right font-medium">@Plain(Total.Get(stat))</td>
                }
                <td class="py-1"></td>
            </tr>
            </tbody>
        </table>

        @* 2. 结论：抗性够不够（✅ 达标 / ⚠️ 差 N，不用颜色当唯一信号）
             目标值优先取「目标BD → 角色总目标」里设的；没设过的才退回可调上限。*@
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
            @foreach (var stat in BasketStatExtensions.Resistances)
            {
                var value = Total.Get(stat);
                var bdTarget = CharacterTarget(stat);
                var target = bdTarget ?? Basket.ResistanceCap;
                var missing = target - value;
                var source = bdTarget.HasValue
                                 ? string.Format(CultureInfo.CurrentCulture, Resources["Basket_Target_FromBd"].Value, Plain(target))
                                 : string.Format(CultureInfo.CurrentCulture, Resources["Basket_Target_Default"].Value, Plain(target));
                var text = missing <= 0
                               ? $"{Resources[stat.ResourceKey()]} {Plain(value)} {Resources["Basket_Cap_Ok"]}{source}"
                               : $"{Resources[stat.ResourceKey()]} {Plain(value)} {string.Format(CultureInfo.CurrentCulture, Resources["Basket_Cap_Short"].Value, Plain(missing))}{source}";

                <TextBase Class="@($"text-sm {(missing <= 0 ? "text-green-400" : "text-amber-400")}")">@text</TextBase>
            }
        </div>
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Target_Note"]</TextBase>

        @* 3. 属性区：装备提供的属性加值合计 *@
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
            @foreach (var stat in BasketStatExtensions.Attributes)
            {
                <TextBase Class="text-sm text-stone-300">@AttributeLabel(stat) @Delta(Total.Get(stat))</TextBase>
            }
        </div>
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Attribute_Note"]</TextBase>

        @* 4. 有当前装备快照的部位：替换前后对比 *@
        @if (Comparisons.Count == 0)
        {
            <TextBase Class="mt-3 text-stone-500 text-xs">@Resources["Basket_No_Snapshot"]</TextBase>
        }
        else
        {
            <TextBase Class="mt-3 text-sm font-medium text-stone-400">@Resources["Basket_Compare_Title"]</TextBase>
            @foreach (var comparison in Comparisons)
            {
                <TextBase Class="text-stone-400 text-xs">
                    @string.Format(CultureInfo.CurrentCulture, Resources["Basket_Compare_Slot"].Value, SlotLabel(comparison.SlotKey), comparison.CurrentName)
                </TextBase>
                @if (comparison.Current.IsEmpty)
                {
                    @* 快照解析出来了但一个抗性/属性都没有（常见于导入 BD 的英文物品文本）：如实说，别让人以为「换上去白赚」*@
                    <TextBase Class="text-amber-400 text-xs">@Resources["Basket_Compare_Unparsable"]</TextBase>
                }
                <div class="flex flex-wrap gap-x-4 gap-y-1">
                    @foreach (var stat in BasketStatExtensions.All)
                    {
                        var before = comparison.Current.Get(stat);
                        var after = comparison.Next.Get(stat);
                        if (before == 0 && after == 0)
                        {
                            continue;
                        }

                        <TextBase Class="text-sm text-stone-300">
                            @StatLabel(stat) @Plain(before) → @Plain(after)（@Delta(after - before)）
                        </TextBase>
                    }
                </div>
            }
        }

        <div class="mt-3">
            <ButtonSecondary OnClick="Basket.Clear">@Resources["Basket_Clear"]</ButtonSecondary>
        </div>
    }

    @* 5. 抗性上限：可改（+最大抗性 / 升华都会动它）*@
    <div class="mt-3 flex flex-wrap items-end gap-3">
        <div class="w-40">
            <FormNumber Label="@Resources["Basket_Cap"]"
                        Value="@Basket.ResistanceCap"
                        ValueChanged="SetResistanceCap"
                        Min="0"
                        Max="200"/>
        </div>
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Cap_Note"]</TextBase>
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Cap_Note_Bd"]</TextBase>
    </div>

    @* 6. 诚实边界：一条都不能省 *@
    <div class="mt-3 flex flex-col gap-1">
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Note_Scope"]</TextBase>
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Note_AllEle"]</TextBase>
        <TextBase Class="text-stone-500 text-xs">@Resources["Basket_Note_Additive"]</TextBase>
    </div>

</FormFieldset>

@inject IStringLocalizer<BuildTargetResources> Resources
@inject CandidateBasketService Basket
@inject BuildTargetStore Store
@inject ItemParser ItemParser
@inject ISettingsService SettingsService

@code {

    private string KeybindText { get; set; } = "Ctrl+B";

    private BasketContribution Total { get; set; } = new();

    private List<BasketComparison> Comparisons { get; set; } = [];

    private int EnabledCount => Basket.Items.Count(x => x.Enabled);

    protected override async Task OnInitializedAsync()
    {
        Basket.OnChanged += OnChanged;
        Store.OnChanged += OnChanged;

        var keybind = await SettingsService.GetString(SettingKeys.KeyAddToBasket);
        if (!string.IsNullOrWhiteSpace(keybind))
        {
            KeybindText = keybind;
        }

        Refresh();

        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        Refresh();
        base.OnParametersSet();
    }

    private void OnChanged()
    {
        // Refresh 会读写组件状态（Total / Comparisons）并枚举 Basket.Items，
        // 而 OnChanged 是在调用方线程上触发的（快捷键入篮 = 后台线程）。
        // 必须整体回 UI 线程 —— 之前只把 StateHasChanged 包进 InvokeAsync，
        // 前半段等于在后台线程改组件状态。审计（2026-09-19）发现。
        _ = InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });
    }

    /// <summary>重算合计 + 需要做替换对比的部位。</summary>
    private void Refresh()
    {
        Total = CandidateBasketCalculator.Sum(Basket.Items);
        Comparisons = BuildComparisons();
    }

    /// <summary>
    /// 只有在「目标BD」里给该部位采过当前装备快照时，才能算替换前后。
    /// 快照是物品原文，这里用同一套解析器解析后再折算，和 Basket 里的算法完全一致。
    /// </summary>
    private List<BasketComparison> BuildComparisons()
    {
        var result = new List<BasketComparison>();

        var equipped = Store.Active?.Equipped;
        if (equipped == null)
        {
            return result;
        }

        foreach (var slotKey in Basket.Items.Select(x => x.SlotKey).Distinct())
        {
            if (!equipped.TryGetValue(slotKey, out var snapshotText) || string.IsNullOrWhiteSpace(snapshotText))
            {
                continue;
            }

            var enabled = Basket.Items.Where(x => x.SlotKey == slotKey && x.Enabled).ToList();
            if (enabled.Count == 0)
            {
                continue;
            }

            Item? snapshot;
            try
            {
                snapshot = ItemParser.ParseItem(snapshotText);
            }
            catch
            {
                // 快照解析不了（多是导入 BD 的英文物品文本）：不猜，跳过这个部位
                continue;
            }

            var next = new BasketContribution();
            foreach (var entry in enabled)
            {
                next.Add(entry.Contribution);
            }

            result.Add(new BasketComparison
            {
                SlotKey = slotKey,
                CurrentName = snapshot.Name ?? snapshot.Type ?? slotKey,
                Current = CandidateBasketCalculator.Contribute(snapshot),
                Next = next,
            });
        }

        return result;
    }

    private void SetEnabled(CandidateBasketItem entry, bool enabled) => Basket.SetEnabled(entry.Id, enabled);

    private void SetResistanceCap(double? value) => Basket.ResistanceCap = value ?? 75;

    /// <summary>
    /// 备选篮里每个统计项，对应「目标BD → 角色总目标」里可能用的匹配词。
    /// 和 StatPresets.ForCharacterTargets() 用的是同一套关键词，两边不要各写一份。
    /// </summary>
    private static readonly Dictionary<BasketStat, string[]> TargetKeywords = new()
    {
        [BasketStat.FireResistance] = ["to Fire Resistance", "火焰抗性"],
        [BasketStat.ColdResistance] = ["to Cold Resistance", "冰冷抗性"],
        [BasketStat.LightningResistance] = ["to Lightning Resistance", "闪电抗性", "閃電抗性"],
        [BasketStat.ChaosResistance] = ["to Chaos Resistance", "混沌抗性"],
        [BasketStat.Strength] = ["to Strength", "力量"],
        [BasketStat.Dexterity] = ["to Dexterity", "敏捷"],
        [BasketStat.Intelligence] = ["to Intelligence", "智慧"],
    };

    /// <summary>
    /// 取该统计项在「角色总目标」里设的目标值；没设过返回 null（调用方退回抗性上限）。
    /// 硬性门槛（Required）优先于加分项，避免同一个词缀两条时取错。
    /// </summary>
    private double? CharacterTarget(BasketStat stat)
    {
        var character = Store.Active?.Character;
        if (character == null || character.Count == 0)
        {
            return null;
        }

        if (!TargetKeywords.TryGetValue(stat, out var keywords))
        {
            return null;
        }

        var matched = character.FirstOrDefault(t => t.Required && MatchesKeywords(t, keywords))
                   ?? character.FirstOrDefault(t => MatchesKeywords(t, keywords));

        return matched?.MinValue;
    }

    private static bool MatchesKeywords(ModTarget target, string[] keywords) =>
        target.Match.Any(pattern => keywords.Any(
            keyword => pattern.Contains(keyword, StringComparison.OrdinalIgnoreCase)));

    private string SlotLabel(string slotKey) =>
        slotKey == SlotKeys.Unknown ? Resources["Basket_Slot_Unknown"] : Resources["Slot_" + slotKey];

    private string StatLabel(BasketStat stat) => Resources[stat.ResourceKey()];

    private string AttributeLabel(BasketStat stat) => Resources["Basket_Attr_" + stat];

    /// <summary>明细表里的数值：没有贡献的显示 -，避免一屏 0。</summary>
    private static string ItemValue(double value) => value == 0 ? "-" : Plain(value);

    private static string Plain(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Delta(double value) => value > 0
                                                     ? "+" + value.ToString("0.##", CultureInfo.InvariantCulture)
                                                     : value.ToString("0.##", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        Basket.OnChanged -= OnChanged;
        Store.OnChanged -= OnChanged;
    }

    private class BasketComparison
    {
        public required string SlotKey { get; init; }

        public required string CurrentName { get; init; }

        /// <summary>该部位当前装备（快照）的贡献。</summary>
        public required BasketContribution Current { get; init; }

        /// <summary>该部位全部启用备选的贡献合计。</summary>
        public required BasketContribution Next { get; init; }
    }

}
