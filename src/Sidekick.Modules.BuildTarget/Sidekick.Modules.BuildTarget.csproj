<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sidekick.Common.Ui\Sidekick.Common.Ui.csproj" />
    <ProjectReference Include="..\Sidekick.Game.Parser\Sidekick.Game.Parser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 下面两个内部入口只给测试用真实夹具离线验证（index-state 映射、四条 poe.ninja 失败文案），不对外开放。 -->
    <InternalsVisibleTo Include="Sidekick.Modules.BuildTarget.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 通货价格数据随程序发布：复制到主程序根目录，供 CurrencyPriceService 读取 -->
    <None Include="currency-prices.json"
          Condition="Exists('currency-prices.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 词缀权重数据随程序发布：复制到主程序根目录，供 AffixWeightService 读取 -->
    <None Include="affix-weights.json"
          Condition="Exists('affix-weights.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- CoE 做装模型数据（真实权重）随程序发布：复制到主程序根目录，供 AffixPoolCoEService 读取 -->
    <None Include="affix-pool-coe.json"
          Condition="Exists('affix-pool-coe.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 词缀类型数据（前缀/后缀）随程序发布：复制到主程序根目录，供 AffixTypeService 读取 -->
    <None Include="affix-types.json"
          Condition="Exists('affix-types.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
